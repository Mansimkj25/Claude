{
  "name": "interview-coach",
  "version": "0.1.0",
  "description": "Visible, honest interview prep and assist desktop app. No stealth features.",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo 'electron-rebuild failed; run npm run rebuild before starting'",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-assets.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
